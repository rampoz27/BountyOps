# Salin file ini menjadi .env dan isi sesuai kebutuhan.

PORT=5000

# Wajib diisi sebelum deploy ke publik. Kalau kosong, endpoint /api/* tidak
# terproteksi autentikasi apa pun.
API_KEY=

# Daftar origin frontend yang diizinkan mengakses API ini, dipisah koma.
# Contoh: https://bountyops.vercel.app,http://localhost:5173
# Kalau kosong, semua origin diizinkan (hanya untuk development lokal).
CORS_ORIGIN=http://localhost:5173
